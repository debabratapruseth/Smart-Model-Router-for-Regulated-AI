# Safe local template: credentials are intentionally empty and live routers disabled.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ROUTER_MODEL=gpt-4.1-mini-2025-04-14
JEV_ROUTER_MODEL=typesafe/jev-1.13
OPENAI_ROUTER_ENABLED=false
JEV_ROUTER_ENABLED=false
JEV_MOCK_MODE=true
ENABLE_MODEL_EXECUTION=false
LOG_LEVEL=INFO

